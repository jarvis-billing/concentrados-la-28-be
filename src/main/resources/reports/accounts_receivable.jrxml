<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="accounts_receivable"
              pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="a1234567-e5f6-7890-abcd-ef1234567890">

  <!-- ═══ SUB-DATASET: Historial de Pagos ═══════════════════════════════════ -->
  <subDataset name="paymentsDS" uuid="b1234567-e5f6-7890-abcd-ef1234567891">
    <field name="paymentDate"     class="java.time.LocalDateTime"/>
    <field name="amount"          class="java.math.BigDecimal"/>
    <field name="paymentMethod"   class="java.lang.String"/>
    <field name="bankAccountName" class="java.lang.String"/>
    <field name="reference"       class="java.lang.String"/>
    <field name="notes"           class="java.lang.String"/>
    <field name="balanceBefore"   class="java.math.BigDecimal"/>
    <field name="balanceAfter"    class="java.math.BigDecimal"/>
  </subDataset>

  <!-- ═══ SUB-DATASET: Detalle Plano de Facturas (HEADER + PRODUCT rows) ════ -->
  <subDataset name="billingDetailDS" uuid="c8596d76-9767-4035-8316-75308804e44c">
    <field name="rowType"            class="java.lang.String"/>
    <field name="billNumber"         class="java.lang.String"/>
    <field name="billingDate"        class="java.lang.String"/>
    <field name="billTotal"          class="java.math.BigDecimal"/>
    <field name="productDescription" class="java.lang.String"/>
    <field name="quantity"           class="java.math.BigDecimal"/>
    <field name="unitPrice"          class="java.math.BigDecimal"/>
    <field name="subtotal"           class="java.math.BigDecimal"/>
  </subDataset>

  <!-- ═══ CAMPOS PRINCIPALES (AccountSummary) ════════════════════════════════ -->
  <field name="clientName"           class="java.lang.String"/>
  <field name="clientIdNumber"       class="java.lang.String"/>
  <field name="clientPhone"          class="java.lang.String"/>
  <field name="clientAddress"        class="java.lang.String"/>
  <field name="clientNickname"       class="java.lang.String"/>
  <field name="totalDebt"            class="java.math.BigDecimal"/>
  <field name="totalPaid"            class="java.math.BigDecimal"/>
  <field name="currentBalance"       class="java.math.BigDecimal"/>
  <field name="lastPaymentDate"      class="java.time.LocalDateTime"/>
  <field name="daysSinceLastPayment" class="java.lang.Long"/>
  <field name="payments"             class="java.util.List"/>
  <field name="billingDetailLines"   class="java.util.List"/>

  <!-- ═══ VARIABLES DE TOTALES ════════════════════════════════════════════════ -->
  <variable name="totalDebtVar" class="java.math.BigDecimal" calculation="Sum">
    <variableExpression><![CDATA[$F{totalDebt} != null ? $F{totalDebt} : java.math.BigDecimal.ZERO]]></variableExpression>
    <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
  </variable>
  <variable name="totalPaidVar" class="java.math.BigDecimal" calculation="Sum">
    <variableExpression><![CDATA[$F{totalPaid} != null ? $F{totalPaid} : java.math.BigDecimal.ZERO]]></variableExpression>
    <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
  </variable>
  <variable name="totalBalanceVar" class="java.math.BigDecimal" calculation="Sum">
    <variableExpression><![CDATA[$F{currentBalance} != null ? $F{currentBalance} : java.math.BigDecimal.ZERO]]></variableExpression>
    <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
  </variable>

  <background><band splitType="Stretch"/></background>

  <!-- ═══ TÍTULO ═══════════════════════════════════════════════════════════════ -->
  <title>
